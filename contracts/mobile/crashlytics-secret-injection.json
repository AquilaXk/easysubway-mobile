{
  "purpose": "Firebase Crashlytics key-file injection contract (no secret values).",
  "committedSecretsForbidden": [
    ".env",
    ".env.*",
    "google-services.json",
    "GoogleService-Info.plist",
    "firebase_options.dart with production API keys"
  ],
  "android": {
    "localPath": "apps/mobile/android/app/google-services.json",
    "gradleBehavior": "Apply com.google.gms.google-services and com.google.firebase.crashlytics only when google-services.json exists.",
    "ciInjection": {
      "workflow": ".github/workflows/release-artifacts.yml",
      "step": "Android Release Artifact / Restore Crashlytics google-services.json",
      "secretName": "EASYSUBWAY_ANDROID_GOOGLE_SERVICES_JSON_BASE64",
      "encoding": "base64 of google-services.json contents",
      "missingSecretBehavior": "notice + continue without Crashlytics plugin wiring"
    }
  },
  "ios": {
    "localPath": "apps/mobile/ios/Runner/GoogleService-Info.plist",
    "ciInjection": {
      "secretName": "EASYSUBWAY_IOS_GOOGLE_SERVICE_INFO_PLIST_BASE64",
      "encoding": "base64 of GoogleService-Info.plist contents",
      "xcodeBuildPhase": "Inject GoogleService-Info.plist",
      "behavior": "Decode secret into Runner/GoogleService-Info.plist when missing, then copy into app bundle resources. Absence is tolerated for debug/test builds."
    }
  },
  "runtime": {
    "debugCollectionEnabled": false,
    "releaseCollectionEnabled": true,
    "missingConfigBehavior": "initializeMobileCrashReporting soft-fails to NoopCrashlyticsGateway; app continues."
  },
  "customKeysPolicy": {
    "allowed": ["crash stack", "device metadata via Crashlytics defaults"],
    "forbidden": ["user id", "location coordinates", "request body", "credentials"]
  },
  "redaction": {
    "version": 1,
    "approach": "allowlist",
    "summary": "전송 문자열은 원문을 걸러내는 방식이 아니라 닫힌 필드 집합으로 새로 조립한다. 예외 raw message는 폐기하고 길이 구간만 남기며, stack trace만 원문 라인을 재사용하되 URI·filesystem path 정규화 후 frame shape allowlist를 통과한 라인만 남긴다.",
    "implementation": "apps/mobile/lib/core/crashlytics/crash_report_redaction.dart",
    "boundTests": [
      "apps/mobile/test/core/crashlytics/crash_report_redaction_test.dart",
      "apps/mobile/test/core/crashlytics/mobile_error_handlers_test.dart"
    ],
    "coveredPaths": [
      "fatal (recordFatalError)",
      "nonfatal (recordNonFatalError)",
      "flutter (FlutterError.onError -> recordFatalFlutterError)",
      "platform (PlatformDispatcher.onError -> recordFatalError)"
    ],
    "rawMessageDisposition": "discard",
    "allowedPayloadFields": ["code", "subsystem", "type", "fatal", "status", "msg"],
    "errorCodeAllowlist": [
      "API_REQUEST_FAILED",
      "TLS_HANDSHAKE_FAILED",
      "TLS_FAILED",
      "NETWORK_UNAVAILABLE",
      "HTTP_TRANSPORT_FAILED",
      "FILE_SYSTEM_FAILED",
      "TIMEOUT",
      "PLATFORM_PLUGIN_MISSING",
      "PLATFORM_CHANNEL_FAILED",
      "FORMAT_INVALID",
      "RANGE_INVALID",
      "ARGUMENT_INVALID",
      "STATE_INVALID",
      "UNIMPLEMENTED",
      "UNSUPPORTED",
      "TYPE_INVALID",
      "OUT_OF_MEMORY",
      "STACK_OVERFLOW",
      "ASSERTION_FAILED",
      "UNKNOWN_ERROR"
    ],
    "subsystemAllowlist": [
      "flutter-framework",
      "platform-dispatcher",
      "app-report",
      "crash-reporting",
      "unknown"
    ],
    "customKeyAllowlist": [
      "app_build_variant",
      "app_version",
      "crash_error_code",
      "crash_subsystem",
      "device_class",
      "os_class"
    ],
    "limits": {
      "maxSanitizedCrashMessageLength": 256,
      "maxSanitizedStackLines": 96,
      "maxSanitizedStackLineLength": 240,
      "maxCrashTypeTokenLength": 64,
      "maxCrashCustomKeyValueLength": 100
    },
    "syntheticSecretsNotice": "아래 값은 전부 회귀 test 전용 합성 더미다. 실제 자격증명·실제 좌표·실제 사용자 입력이 아니며, 실제 provider 토큰 형식과 일부러 어긋나게 만들어 두었다.",
