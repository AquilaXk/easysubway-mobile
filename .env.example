# ==============================================================================
# EasySubway Mobile Environment Variables Template (.env.example)
# Use these variables with Flutter:
#   flutter run --dart-define-from-file=.env
# Or pass them individually:
#   flutter run --dart-define=EASYSUBWAY_API_BASE_URL=http://localhost:8080 ...
# ==============================================================================

# API Base URL (Backend Service)
# For Android Emulator use http://10.0.2.2:8080, for iOS Simulator use http://localhost:8080
EASYSUBWAY_API_BASE_URL=http://localhost:8080

# Kakao Map Native SDK App Key (from Kakao Developers Console)
EASYSUBWAY_KAKAO_MAP_NATIVE_APP_KEY=sample_kakao_map_native_app_key_32_chars

# Datapack Endpoints & Verification
EASYSUBWAY_DATA_PACK_BASE_URL=http://localhost:9000/datapacks
EASYSUBWAY_DATAPACK_CHANNEL=dev
EASYSUBWAY_DATAPACK_SIGNING_KEY_ID=production-v1
EASYSUBWAY_DATAPACK_SIGNING_PUBLIC_KEY_N=
EASYSUBWAY_DATAPACK_SIGNING_PUBLIC_KEY_E=65537

# Report API & Storage
EASYSUBWAY_REPORT_API_BASE_URL=http://localhost:8080

# Feature Toggles
EASYSUBWAY_PUSH_NOTIFICATIONS_ENABLED=false
EASYSUBWAY_DEMO_HOME_DATA_ENABLED=false
EASYSUBWAY_PERF_LOGS_ENABLED=false

# Support & Legal URLs / Contacts
EASYSUBWAY_TERMS_OF_SERVICE_URL=https://easysubway.app/terms
EASYSUBWAY_PRIVACY_POLICY_URL=https://easysubway.app/privacy
EASYSUBWAY_LOCATION_TERMS_URL=https://easysubway.app/location-terms
EASYSUBWAY_SUPPORT_EMAIL=support@easysubway.app
EASYSUBWAY_DATA_DELETION_EMAIL=privacy@easysubway.app
EASYSUBWAY_SECURITY_EMAIL=security@easysubway.app

# Play Integrity (Android Release)
EASYSUBWAY_GOOGLE_CLOUD_PROJECT_NUMBER=000000000000
